<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="Theme.EvoFit" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#090909</item>
        <item name="android:statusBarColor">#090909</item>
        <item name="android:navigationBarColor">#090909</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#090909</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.EvoFit</item>
    </style>
</resources>